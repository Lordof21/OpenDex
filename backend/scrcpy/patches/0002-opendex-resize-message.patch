 public final class DisplayResizeDebouncer {
 
     public interface Callback {
-        void trigger(Size size);
+        void trigger(Request request);
+    }
+
+    /**
+     * OpenDex: what one resize changes. {@code size == null} keeps the display's size, {@code dpi == 0} its density.
+     */
+    public static final class Request {
+        private final Size size;
+        private final int dpi;
+
+        public Request(Size size, int dpi) {
+            this.size = size;
+            this.dpi = dpi;
+        }
+
+        public Size getSize() {
+            return size;
+        }
+
+        public int getDpi() {
+            return dpi;
+        }
+
+        Request mergedWith(Request newer) {
+            return new Request(newer.size != null ? newer.size : size, newer.dpi != 0 ? newer.dpi : dpi);
+        }
     }
 
     private final Callback callback;
     private final long minIntervalMs;
-    private Size request;
+    private Request request;
     private long deadline;
     private long lastTrigger;
 
@@ -47,7 +72,7 @@ public final class DisplayResizeDebouncer {
     private void debounce() {
         try {
             while (true) {
-                Size newSize;
+                Request newRequest;
                 synchronized (this) {
                     while (true) {
                         long now = SystemClock.uptimeMillis();
@@ -62,11 +87,11 @@ public final class DisplayResizeDebouncer {
                         }
                     }
                     assert request != null : "An active deadline implies request != null";
-                    newSize = request;
+                    newRequest = request;
                     request = null;
                     lastTrigger = SystemClock.uptimeMillis();
                 }
-                callback.trigger(newSize);
+                callback.trigger(newRequest);
             }
         } catch (InterruptedException e) {
             // ignore
@@ -75,12 +100,14 @@ public final class DisplayResizeDebouncer {
         }
     }
 
-    public synchronized void requestResize(Size size) {
-        assert size != null;
+    public synchronized void requestResize(Request newRequest) {
+        assert newRequest != null;
         if (request == null) {
             deadline = Math.max(SystemClock.uptimeMillis(), lastTrigger + minIntervalMs);
+            request = newRequest;
+        } else {
+            request = request.mergedWith(newRequest);
         }
-        request = size;
         notify();
     }
 
