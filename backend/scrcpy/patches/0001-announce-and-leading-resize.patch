+++ b/server/src/main/java/com/genymobile/scrcpy/Options.java
@@ -68,6 +68,7 @@ public class Options {
     private boolean vdDestroyContent = true;
     private boolean vdSystemDecorations = true;
     private boolean flexDisplay;
+    private int resizeMinIntervalMs = 300; // OpenDex: least time between two flex display resizes
 
     private boolean keepActive;
     private boolean ignoreVideoEncoderConstraints;
@@ -275,6 +276,10 @@ public class Options {
         return flexDisplay;
     }
 
+    public int getResizeMinIntervalMs() {
+        return resizeMinIntervalMs;
+    }
+
     public boolean getIgnoreVideoEncoderConstraints() {
         return ignoreVideoEncoderConstraints;
     }
@@ -533,6 +538,9 @@ public class Options {
                 case "flex_display":
                     options.flexDisplay = Boolean.parseBoolean(value);
                     break;
+                case "resize_min_interval_ms":
+                    options.resizeMinIntervalMs = Integer.parseInt(value);
+                    break;
                 case "capture_orientation":
                     Pair<Orientation.Lock, Orientation> pair = parseCaptureOrientation(value);
                     options.captureOrientationLock = pair.first;
diff --git a/server/src/main/java/com/genymobile/scrcpy/Server.java b/server/src/main/java/com/genymobile/scrcpy/Server.java
index d7d1a76..beb4e5c 100644
--- a/server/src/main/java/com/genymobile/scrcpy/Server.java
+++ b/server/src/main/java/com/genymobile/scrcpy/Server.java
@@ -69,6 +69,8 @@ public final class Server {
     }
 
     private static void scrcpy(Options options) throws IOException, ConfigurationException {
+        Ln.i("OpenDex: features=leading_resize,opendex_resize,bitrate_on_reset");
+
         if (Build.VERSION.SDK_INT < AndroidVersions.API_31_ANDROID_12 && options.getVideoSource() == VideoSource.CAMERA) {
             Ln.e("Camera mirroring is not supported before Android 12");
             throw new ConfigurationException("Camera mirroring is not supported");
diff --git a/server/src/main/java/com/genymobile/scrcpy/display/DisplayResizeDebouncer.java b/server/src/main/java/com/genymobile/scrcpy/display/DisplayResizeDebouncer.java
index 0b961c6..71591ec 100644
--- a/server/src/main/java/com/genymobile/scrcpy/display/DisplayResizeDebouncer.java
+++ b/server/src/main/java/com/genymobile/scrcpy/display/DisplayResizeDebouncer.java
@@ -5,22 +5,28 @@ import com.genymobile.scrcpy.util.Ln;
 
 import android.os.SystemClock;
 
+/**
+ * OpenDex: leading edge instead of a fixed delay. A request reaching an idle debouncer is triggered at once; while
+ * resizes keep coming, at least {@code minIntervalMs} separate two triggers and only the newest request is applied.
+ */
 public final class DisplayResizeDebouncer {
 
-    private static final long DEBOUNCE_DELAY_MS = 300;
-
     public interface Callback {
         void trigger(Size size);
     }
 
     private final Callback callback;
+    private final long minIntervalMs;
     private Size request;
     private long deadline;
+    private long lastTrigger;
 
     private Thread thread;
 
-    public DisplayResizeDebouncer(Callback callback) {
+    public DisplayResizeDebouncer(Callback callback, long minIntervalMs) {
         this.callback = callback;
+        this.minIntervalMs = minIntervalMs;
+        this.lastTrigger = SystemClock.uptimeMillis() - minIntervalMs;
     }
 
     public void start() {
@@ -58,6 +64,7 @@ public final class DisplayResizeDebouncer {
                     assert request != null : "An active deadline implies request != null";
                     newSize = request;
                     request = null;
+                    lastTrigger = SystemClock.uptimeMillis();
                 }
                 callback.trigger(newSize);
             }
@@ -71,7 +78,7 @@ public final class DisplayResizeDebouncer {
     public synchronized void requestResize(Size size) {
         assert size != null;
         if (request == null) {
-            deadline = SystemClock.uptimeMillis() + DEBOUNCE_DELAY_MS;
+            deadline = Math.max(SystemClock.uptimeMillis(), lastTrigger + minIntervalMs);
         }
         request = size;
         notify();
